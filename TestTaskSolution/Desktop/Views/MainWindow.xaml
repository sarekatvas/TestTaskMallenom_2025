<Window x:Class="Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Images" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
            <Button Content="Добавить" Command="{Binding AddCommand}" Margin="5" Width="100"/>
            <Button Content="Изменить" Command="{Binding EditCommand}" Margin="5" Width="100"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5" Width="100"/>
        </StackPanel>

        <ListView ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" Grid.Row="0" Padding="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Наименование" DisplayMemberBinding="{Binding FileName}" Width="auto" />
                    <GridViewColumn Header="Изображение" Width="auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image 
                            Source="{Binding Data}"
                            Width="200" 
                            Height="150"
                            Stretch="UniformToFill"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>