<Window x:Class="Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Manager" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Панель кнопок -->
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Button Content="Добавить" Command="{Binding AddCommand}" Margin="5" Width="100"/>
            <Button Content="Изменить" Command="{Binding}" Margin="5" Width="100"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5" Width="100"/>
        </StackPanel>

        <!-- Список изображений -->
        <ListView ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" Grid.Row="0" Padding="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Наименование" DisplayMemberBinding="{Binding FileName}" Width="auto"/>
                    <GridViewColumn Header="Изображение" DisplayMemberBinding="{Binding Data}" Width="auto"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>